# Copy to pw-poc/.env (gitignored) and fill in. Real environment variables take precedence over this file.
DIA_BASE_URL=http://localhost:8081
DIA_USERNAME=admin
DIA_PASSWORD=admin
# Maximum accepted response time per request, in milliseconds (default 3000)
DIA_MAX_RESPONSE_MS=3000

# Optional: any NON-admin DIA account. Enables the role-based authorization tests (tests/roleBased.spec.js),
# which are skipped with a "BLOCKED" reason while these are empty.
DIA_VIEWER_USERNAME=
DIA_VIEWER_PASSWORD=
